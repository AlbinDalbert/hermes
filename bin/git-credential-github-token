#!/usr/bin/env sh
set -eu

action="${1:-}"

if [ "${action}" != "get" ]; then
    exit 0
fi

protocol=""
host=""

while IFS= read -r line; do
    [ -n "${line}" ] || break
    case "${line}" in
        protocol=*) protocol="${line#protocol=}" ;;
        host=*) host="${line#host=}" ;;
    esac
done

if [ "${protocol}" != "https" ] || [ "${host}" != "github.com" ]; then
    exit 0
fi

if [ -n "${GITHUB_TOKEN:-}" ]; then
    token="${GITHUB_TOKEN}"
elif [ -n "${GITHUB_TOKEN_FILE:-}" ] && [ -r "${GITHUB_TOKEN_FILE}" ]; then
    token="$(cat "${GITHUB_TOKEN_FILE}")"
elif [ -r /var/run/secrets/hermes-github/GITHUB_TOKEN ]; then
    token="$(cat /var/run/secrets/hermes-github/GITHUB_TOKEN)"
else
    exit 0
fi

[ -n "${token}" ] || exit 0

printf 'username=x-access-token\n'
printf 'password=%s\n' "${token}"
